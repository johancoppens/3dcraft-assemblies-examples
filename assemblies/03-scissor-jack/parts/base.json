[
 ["table.set", {"name": "sizes", "columns": ["row", {"name": "foot_thickness", "unit": "mm"}, {"name": "wall_beyond_pivot", "unit": "mm"}, {"name": "wall_above_pivot", "unit": "mm"}, {"name": "wall_corner", "unit": "mm"}, {"name": "notch_ligament", "unit": "mm"}, {"name": "notch_drop", "unit": "mm"}, {"name": "foot_length", "unit": "mm"}, {"name": "foot_width", "unit": "mm"}, {"name": "foot_corner", "unit": "mm"}], "rows": [["all", 3, 26, 16, 14, 3, 4, 160, 108, 18]]}],
