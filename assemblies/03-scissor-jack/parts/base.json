 ["variable.publish", {"name": "plate_thickness", "label": "Plate", "group": "Base", "order": 4, "description": "Sheet thickness", "min": "2.5 mm", "max": "3 mm"}],
 ["variable.publish", {"name": "bend_radius", "label": "Bend radius", "group": "Base", "order": 5, "description": "Inner bend radius", "min": "3 mm", "max": "3.5 mm"}],
