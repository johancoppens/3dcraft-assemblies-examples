 ["sketch.circle", {"sketch": "Minus wall", "center": ["pivot_x", "-(web_half + pivot_height - bend_tangent)"], "radius": "pin_hole / 2"}],
 ["sketch.create", {"name": "Channel web", "plane": "Channel underside"}],
