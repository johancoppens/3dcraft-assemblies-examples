[
 ["table.set", {"name": "sizes", "columns": ["row", {"name": "head_diameter", "unit": "mm"}, {"name": "head_height", "unit": "mm"}, {"name": "head_chamfer", "unit": "mm"}, {"name": "tip_chamfer", "unit": "mm"}], "rows": [["all", 19, 4, 1, 0.8]]}],
