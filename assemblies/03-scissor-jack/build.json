 ["variable.output", {"name": "lower_torque", "expr": "screw_force * screw_mean_diameter / 2 * tan(friction_angle - lead_angle)", "label": "Torque to lower, thread alone", "unit": "N*m"}],
 ["variable.output", {"name": "root_torsion_stress", "expr": "16 * thread_torque / (pi * screw_root_diameter^3)", "label": "Root torsion stress", "unit": "MPa"}],
 ["variable.output", {"name": "root_von_mises", "expr": "sqrt(root_tension_stress^2 + 3 * root_torsion_stress^2)", "label": "Root von Mises stress", "unit": "MPa"}],
 ["variable.output", {"name": "hand_force", "expr": "raise_torque / sizes[\"all\"].handle_length", "label": "Hand force on the grip to raise", "unit": "N"}],
 ["variable.output", {"name": "height_tension_at_two", "expr": "sizes[\"all\"].base_pivot_height + 2 * arm_length * sin(atan(saddle_load * standard_gravity / (stress_limit_two * pi * screw_root_diameter^2 / 4))) + saddle_pivot_drop + sizes[\"all\"].pad_thickness", "label": "Saddle height where root tension reaches half the assumed yield", "unit": "mm"}],
 ["variable.output", {"name": "height_tension_at_four", "expr": "sizes[\"all\"].base_pivot_height + 2 * arm_length * sin(atan(saddle_load * standard_gravity / (stress_limit_four * pi * screw_root_diameter^2 / 4))) + saddle_pivot_drop + sizes[\"all\"].pad_thickness", "label": "Saddle height where root tension reaches a quarter of the assumed yield", "unit": "mm"}],
 ["variable.output", {"name": "rod_run", "expr": "sqrt((rod_end_x - joint_x)^2 + (rod_end_z - joint_z)^2)", "label": "Rod length from the measured points", "unit": "mm"}],
 ["variable.output", {"name": "axis_x", "expr": "(rod_end_x - joint_x) / rod_run", "label": "Rod axis, x component"}],
 ["variable.output", {"name": "axis_z", "expr": "(rod_end_z - joint_z) / rod_run", "label": "Rod axis, z component"}],
 ["variable.output", {"name": "grip_along", "expr": "(grip_x - joint_x) * axis_x + (grip_z - joint_z) * axis_z", "label": "Grip corner along the rod", "unit": "mm"}],
 ["variable.output", {"name": "grip_orbit", "expr": "sqrt((grip_x - joint_x)^2 + grip_y^2 + (grip_z - joint_z)^2 - grip_along^2)", "label": "Radius of the grip corner's circle about the rod", "unit": "mm"}],
 ["variable.output", {"name": "handle_sweep_low", "expr": "joint_z + grip_along * axis_z - grip_orbit * sqrt(1 - axis_z^2)", "label": "Lowest point of the handle's turn above the ground", "unit": "mm"}],
 ["assert.add", {"name": "Saddle follows the rhombus closed form", "measure": "value", "expr": "saddle_z", "eq": "sizes[\"all\"].base_pivot_height + sqrt(4 * arm_length^2 - (low_span - lift_fraction * (low_span - high_span) - 2 * pivot_offset)^2) + saddle_pivot_drop", "tol": "0.02 mm"}],
 ["assert.add", {"name": "Saddle stays level", "measure": "rotation", "instance": "Saddle", "axis": "y", "eq": "0 deg", "tol": "0.02 deg"}],
 ["assert.add", {"name": "Saddle stays centred", "measure": "position", "instance": "Saddle", "axis": "x", "eq": "0 mm", "tol": "0.02 mm"}],
 ["assert.add", {"name": "Trunnion span is lead times turns", "measure": "value", "expr": "trunnion_span", "eq": "low_span - lift_fraction * full_turns * screw_lead", "tol": "0.02 mm"}],
 ["assert.add", {"name": "Bearing trunnion mirrors the nut", "measure": "value", "expr": "nut_x + bearing_x", "eq": "0 mm", "tol": "0.02 mm"}],
 ["assert.add", {"name": "Arm angle follows the screw", "measure": "value", "expr": "arm_elevation", "eq": "acos((low_span - lift_fraction * (low_span - high_span) - 2 * pivot_offset) / (2 * arm_length))", "tol": "0.02 deg"}],
 ["assert.add", {"name": "Screw force from the joint angle equals the virtual-work value from positions", "measure": "value", "expr": "screw_force * (saddle_z - sizes[\"all\"].base_pivot_height - saddle_pivot_drop) / (saddle_load * standard_gravity * (trunnion_span - 2 * pivot_offset))", "eq": "1", "tol": "0.0001"}],
 ["assert.add", {"name": "Lowest saddle height", "measure": "value", "expr": "lift_height", "eq": "sizes[\"all\"].base_pivot_height + 2 * arm_length * sin(sizes[\"all\"].low_angle) + saddle_pivot_drop + sizes[\"all\"].pad_thickness", "tol": "0.02 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Highest saddle height", "measure": "value", "expr": "lift_height", "eq": "sizes[\"all\"].base_pivot_height + 2 * arm_length * sin(sizes[\"all\"].high_angle) + saddle_pivot_drop + sizes[\"all\"].pad_thickness", "tol": "0.02 mm", "when": "abs(t - 0.5) < 1e-6"}],
 ["assert.add", {"name": "Hooke joint follows its closed form", "measure": "value", "expr": "sin(screw_turn) * cos(crank_spin) - cos(screw_turn) * cos(sizes[\"all\"].crank_tilt) * sin(crank_spin)", "eq": "0", "tol": "0.001"}],
 ["assert.add", {"name": "Handle clears the ground on every turn", "measure": "value", "expr": "handle_sweep_low", "min": "sizes[\"all\"].floor_clearance_min"}],
 ["assert.add", {"name": "Root von Mises stress at the top of the stroke below half the assumed yield", "measure": "value", "expr": "root_von_mises", "max": "sizes[\"all\"].assumed_yield / 2", "when": "abs(t - 0.5) < 1e-6"}],
 ["assert.add", {"name": "Screw self-locks at the lowest friction assumed", "measure": "value", "expr": "lead_angle", "max": "atan(sizes[\"all\"].lowest_thread_friction)"}],
 ["assert.add", {"name": "Upper arms clear of the lower arms", "measure": "clearance", "from": "Upper left arm", "to": "Lower left arm", "min": "0.4 mm"}],
 ["assert.add", {"name": "Screw clear of the lower arms", "measure": "clearance", "from": "Screw", "to": "Lower right arm", "min": "1 mm"}],
 ["assert.add", {"name": "Screw clear of the upper arms", "measure": "clearance", "from": "Screw", "to": "Upper right arm", "min": "1 mm"}],
 ["assert.add", {"name": "Lower gears mesh with backlash and no contact", "measure": "clearance", "from": "Lower right arm", "to": "Lower left arm", "min": "0.05 mm", "max": "0.5 mm"}],
 ["assert.add", {"name": "Upper gears mesh with backlash and no contact", "measure": "clearance", "from": "Upper left arm", "to": "Upper right arm", "min": "0.05 mm", "max": "0.5 mm"}],
 ["assert.add", {"name": "Upper arm is as wide as the assembly's sheet thickness says", "measure": "extent", "of": "Upper left arm", "axis": "y", "eq": "upper_outer_width", "tol": "0.01 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Base rivet fits the lower arm", "measure": "clearance", "from": "Base rivet left", "to": "Lower left arm", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Base rivet fits the base wall", "measure": "clearance", "from": "Base rivet left", "to": "Base", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Saddle rivet fits the upper arm", "measure": "clearance", "from": "Saddle rivet left", "to": "Upper left arm", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Saddle rivet fits the saddle wall", "measure": "clearance", "from": "Saddle rivet left", "to": "Saddle/Saddle frame", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Trunnion pin fits the lower arm", "measure": "clearance", "from": "Nut pin plus", "to": "Lower left arm", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Trunnion pin fits the upper arm", "measure": "clearance", "from": "Nut pin plus", "to": "Upper left arm", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["assert.add", {"name": "Screw shank fits the bearing bore", "measure": "clearance", "from": "Screw", "to": "Bearing trunnion", "min": "0.12 mm", "max": "0.25 mm", "when": "abs(t) < 1e-6"}],
 ["document.info", {"title": "Scissor car jack", "description": "A pressed-steel scissor jack sized after jacks sold as 1 t: four U-section arms with involute gear sectors, a screw through a nut trunnion and a bearing trunnion, a saddle kept level by the gears, and a tilted folding crank on a Hooke joint.", "author": "3DCraft assemblies", "licence": "CC-BY-4.0", "tags": ["jack", "sheet metal", "mechanism"]}],
 ["document.check", {}]
