  }
 ],
 [
  "sketch.path",
  {
   "sketch": "Cup profile",
   "start": [
    "bell_top",
    "cup_bore"
   ],
   "segments": [
    {
     "line": [
      "bell_top",
      "cup_radius"
     ]
    },
    {
     "line": [
      "0 mm",
      "cup_radius"
     ]
    },
    {
     "line": [
