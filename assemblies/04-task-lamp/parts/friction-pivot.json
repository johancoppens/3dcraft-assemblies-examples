   "expr": "0.1 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "nut_seat",
   "expr": "cheek_outer + head_gap + spring_washer_height + head_gap"
  }
 ],
 [
  "sketch.create",
  {
   "name": "Screw profile",
   "plane": "xy"
  }
 ],
 [
  "sketch.path",
  {
   "sketch": "Screw profile",
   "start": [
    "0 mm",
    "-cheek_outer - head_gap - head_height"
   ],
   "segments": [
    {
     "line": [
      "head_radius - 1 mm",
      "-cheek_outer - head_gap - head_height"
     ]
    },
    {
     "arc": [
      "head_radius",
      "-cheek_outer - head_gap - head_height + 1 mm"
     ],
     "center": [
      "head_radius - 1 mm",
      "-cheek_outer - head_gap - head_height + 1 mm"
     ]
    },
    {
     "line": [
      "head_radius",
      "-cheek_outer - head_gap"
     ]
    },
    {
     "line": [
      "shank_radius",
      "-cheek_outer - head_gap"
     ]
    },
    {
     "line": [
      "shank_radius",
      "nut_seat + nut_height - 0.5 mm"
     ]
    },
    {
     "line": [
      "0 mm",
      "nut_seat + nut_height - 0.5 mm"
     ]
    },
    {
     "line": "start"
    }
   ]
  }
 ],
 [
  "feature.revolve",
  {
   "sketch": "Screw profile",
   "axis": "y",
   "name": "Tension screw"
  }
 ],
 [
  "sketch.create",
  {
   "name": "Nut profile",
   "plane": "xy"
  }
 ],
 [
  "sketch.path",
  {
   "sketch": "Nut profile",
   "start": [
    "shank_radius + thread_clear",
    "nut_seat"
   ],
   "segments": [
    {
     "line": [
      "head_radius",
      "nut_seat"
     ]
    },
    {
     "line": [
      "head_radius",
      "nut_seat + nut_height - 0.8 mm"
     ]
    },
    {
     "line": [
      "head_radius - 0.8 mm",
      "nut_seat + nut_height"
     ]
    },
    {
     "line": [
      "shank_radius + thread_clear",
      "nut_seat + nut_height"
     ]
    },
    {
     "line": "start"
    }
   ]
  }
 ],
