     "0 mm",
     0,
     "0 mm"
    ],
    [
     "0 mm + 1 mm",
     0,
     "0 mm"
    ],
    [
     "0 mm",
     0,
     "0 mm - 1 mm"
    ]
   ]
  }
 ],
 [
  "datum.plane",
  {
   "name": "Pivot B",
   "through": [
    [
     "handle_pivot_x",
     0,
     "handle_pivot_z"
    ],
    [
     "handle_pivot_x + 1 mm",
     0,
     "handle_pivot_z"
    ],
    [
     "handle_pivot_x",
     0,
     "handle_pivot_z - 1 mm"
    ]
   ]
  }
 ],
 [
  "datum.point",
  {
   "name": "B point",
   "at": [
    "handle_pivot_x",
    0,
    "handle_pivot_z"
   ]
  }
 ],
 [
  "datum.plane",
  {
   "name": "Spindle axis",
   "through": [
    [
     "-spindle_reach",
     0,
     "strip_top"
    ],
    [
     "-spindle_reach + 1 mm",
     0,
     "strip_top"
    ],
    [
     "-spindle_reach",
     "1 mm",
     "strip_top"
    ]
   ]
  }
 ],
 [
  "datum.plane",
  {
   "name": "Lower seat",
   "through": [
    [
     "-spindle_reach",
     0,
     "strip_bottom"
    ],
    [
     "-spindle_reach + 1 mm",
     0,
     "strip_bottom"
    ],
    [
     "-spindle_reach",
     "-1 mm",
     "strip_bottom"
    ]
   ]
  }
 ],
 [
  "assert.add",
  {
   "name": "Inner bend radius at least the thickness",
   "measure": "bendRadius",
   "of": "U-bar",
   "min": "plate_thickness"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bores clear the bends by 2.5 t + r",
   "measure": "holeToBend",
   "of": "U-bar",
   "min": "2.5 * plate_thickness + bend_radius"
  }
 ],
 [
  "assert.add",
  {
   "name": "Overall width of the two legs",
   "measure": "extent",
   "of": "U-bar",
   "axis": "y",
   "eq": "2 * (leg_inner_y + plate_thickness)",
   "tol": "0.001"
  }
 ],
 [
  "document.info",
  {
   "title": "Toggle clamp U-bar",
   "description": "Formed U-bar from one blank: a narrow web at the tip and two legs, the spindle slot between them, carrying the bar pivot and the handle pivot.",
