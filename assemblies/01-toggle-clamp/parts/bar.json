   "order": 7,
   "min": "4.5 mm",
   "max": "6 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "tip_x",
   "expr": "-71.9 mm"
  }
 ],
 [
  "variable.publish",
  {
   "name": "tip_x",
   "label": "Tip x",
   "description": "Set by the assembly",
   "group": "U-bar",
   "order": 8,
   "min": "-73 mm",
   "max": "-71 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "stop_x",
   "expr": "6.6545 mm"
  }
 ],
 [
  "variable.publish",
  {
   "name": "stop_x",
   "label": "Stop x",
   "description": "Set by the assembly",
   "group": "U-bar",
   "order": 9,
   "min": "5.2 mm",
   "max": "8 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "spindle_reach",
   "expr": "28.6 mm"
  }
 ],
 [
  "variable.publish",
  {
   "name": "spindle_reach",
   "label": "Spindle reach",
   "description": "Set by the assembly",
   "group": "U-bar",
   "order": 10,
   "min": "24 mm",
   "max": "68 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "bend_radius",
   "expr": "plate_thickness"
  }
 ],
 [
  "variable.set",
  {
   "name": "k_factor",
   "expr": "(0.65 + 0.5 * ln(bend_radius / plate_thickness) / ln(10)) / 2"
  }
 ],
 [
  "variable.set",
  {
   "name": "flat_start_x",
   "expr": "tip_x + plate_thickness + bend_radius"
  }
 ],
 [
  "variable.set",
  {
   "name": "web_half",
   "expr": "leg_inner_y - bend_radius"
  }
 ],
 [
  "variable.set",
  {
   "name": "handle_pivot_x",
   "expr": "bar_arm * cos(arm_angle)"
  }
 ],
 [
  "variable.set",
  {
   "name": "handle_pivot_z",
   "expr": "bar_arm * sin(arm_angle)"
  }
 ],
 [
  "variable.set",
  {
   "name": "boss_radius",
   "expr": "5.65 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "boss_corner",
   "expr": "5 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "corner",
   "expr": "2.5 mm"
  }
 ],
 [
  "sketch.create",
  {
   "name": "Tip web",
   "plane": "yz",
   "offset": "tip_x"
  }
 ],
 [
  "sketch.path",
  {
   "sketch": "Tip web",
   "start": [
    "-web_half",
    "strip_bottom"
   ],
   "segments": [
    {
     "line": [
      "web_half",
      "strip_bottom"
     ]
    },
    {
     "line": [
      "web_half",
      "strip_top"
     ]
    },
    {
     "line": [
      "-web_half",
      "strip_top"
     ]
    },
    {
     "line": "start"
    }
   ]
  }
 ],
 [
  "sketch.create",
  {
   "name": "Near leg",
   "plane": "yz",
   "offset": "tip_x"
  }
 ],
 [
  "sketch.path",
  {
   "sketch": "Near leg",
   "start": [
    "web_half + ((flat_start_x) - flat_start_x)",
    "strip_bottom"
   ],
   "segments": [
    {
     "line": [
      "web_half + ((stop_x) - flat_start_x) + -1.000000 * (0.6 mm)",
      "strip_bottom + 0.000000 * (0.6 mm)"
     ]
    },
    {
     "arc": [
      "web_half + ((stop_x) - flat_start_x) + 0.000000 * (0.6 mm)",
      "strip_bottom + 1.000000 * (0.6 mm)"
     ],
     "radius": "0.6 mm"
    },
    {
     "line": [
      "web_half + ((stop_x) - flat_start_x) + 0.000000 * (corner)",
      "strip_top + -0.269584 * (corner)"
     ]
    },
    {
     "arc": [
      "web_half + ((stop_x) - flat_start_x) + 0.135504 * (corner)",
      "strip_top + 0.233055 * (corner)"
     ],
     "radius": "corner",
     "clockwise": true
    },
    {
     "line": [
      "web_half + ((handle_pivot_x + boss_radius) - flat_start_x) + -0.135504 * (corner)",
      "handle_pivot_z - 3 mm + -0.233055 * (corner)"
     ]
    },
    {
     "arc": [
      "web_half + ((handle_pivot_x + boss_radius) - flat_start_x) + 0.000000 * (corner)",
      "handle_pivot_z - 3 mm + 0.269584 * (corner)"
     ],
     "radius": "corner"
    },
    {
     "line": [
      "web_half + ((handle_pivot_x + boss_radius) - flat_start_x) + 0.000000 * (boss_corner)",
      "handle_pivot_z + boss_radius + -1.000000 * (boss_corner)"
     ]
    },
    {
     "arc": [
      "web_half + ((handle_pivot_x + boss_radius) - flat_start_x) + -1.000000 * (boss_corner)",
      "handle_pivot_z + boss_radius + 0.000000 * (boss_corner)"
     ],
     "radius": "boss_corner"
    },
    {
     "line": [
      "web_half + ((handle_pivot_x - boss_radius) - flat_start_x) + 1.000000 * (boss_corner)",
      "handle_pivot_z + boss_radius + 0.000000 * (boss_corner)"
     ]
    },
    {
     "arc": [
      "web_half + ((handle_pivot_x - boss_radius) - flat_start_x) + 0.000000 * (boss_corner)",
      "handle_pivot_z + boss_radius + -1.000000 * (boss_corner)"
     ],
     "radius": "boss_corner"
    },
    {
     "line": [
      "web_half + ((handle_pivot_x - boss_radius) - flat_start_x) + 0.000000 * (corner)",
      "strip_top + 1.000000 * (corner)"
     ]
    },
    {
     "arc": [
      "web_half + ((handle_pivot_x - boss_radius) - flat_start_x) + -1.000000 * (corner)",
      "strip_top + 0.000000 * (corner)"
     ],
     "radius": "corner",
     "clockwise": true
    },
    {
     "line": [
      "web_half + ((flat_start_x) - flat_start_x)",
      "strip_top"
     ]
    },
    {
     "line": "start"
    }
   ]
  }
 ],
 [
  "sketch.circle",
  {
   "sketch": "Near leg",
   "center": [
    "web_half + ((0 mm) - flat_start_x)",
    "0 mm"
   ],
   "radius": "pivot_bore / 2"
  }
 ],
 [
  "sketch.circle",
