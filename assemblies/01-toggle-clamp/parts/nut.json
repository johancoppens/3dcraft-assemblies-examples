    {
     "line": [
      "0 mm",
      "corner_radius - 0.8 mm"
     ]
    },
    {
     "line": [
      "0.46 mm",
      "corner_radius"
     ]
    },
    {
     "line": [
      "nut_height - 0.46 mm",
