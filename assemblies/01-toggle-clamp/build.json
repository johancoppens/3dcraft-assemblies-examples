   "expr": "58.4 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "link_boss_radius",
   "expr": "4.5 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "stop_gap",
   "expr": "0.05 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "grip_force_arm",
   "expr": "74.5 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "grip_centre_z",
   "expr": "27.5 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "grip_end_position",
   "expr": "108.8 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "leg_inner_y",
   "expr": "spindle_slot / 2"
  }
 ],
 [
  "variable.set",
  {
   "name": "ear_inner_y",
   "expr": "leg_inner_y + plate_thickness + layer_gap"
  }
 ],
 [
  "variable.set",
  {
   "name": "handle_inner_y",
   "expr": "leg_inner_y - plate_thickness - layer_gap"
  }
 ],
 [
  "variable.set",
  {
   "name": "rivet_span_base",
   "expr": "2 * (ear_inner_y + plate_thickness + rivet_head_gap)"
  }
 ],
 [
  "variable.set",
  {
   "name": "rivet_span_handle",
   "expr": "2 * (leg_inner_y + plate_thickness + rivet_head_gap)"
  }
 ],
 [
  "variable.set",
  {
   "name": "toggle_bd",
   "expr": "sqrt(link_bc^2 + link_cd^2 + 2 * link_bc * link_cd * cos(over_centre_angle))"
  }
 ],
 [
  "variable.set",
  {
   "name": "span_ad",
   "expr": "hypot(pivot_d_x - pivot_a_x, pivot_d_z - pivot_a_z)"
  }
 ],
 [
  "variable.set",
  {
   "name": "angle_ad",
   "expr": "atan2(pivot_d_z - pivot_a_z, pivot_d_x - pivot_a_x)"
  }
 ],
 [
  "variable.set",
  {
   "name": "angle_ab",
   "expr": "angle_ad + acos((link_ab^2 + span_ad^2 - toggle_bd^2) / (2 * link_ab * span_ad))"
  }
 ],
 [
  "variable.set",
  {
   "name": "pivot_b_x",
   "expr": "pivot_a_x + link_ab * cos(angle_ab)"
  }
 ],
 [
  "variable.set",
  {
   "name": "pivot_b_z",
   "expr": "pivot_a_z + link_ab * sin(angle_ab)"
  }
 ],
 [
  "variable.set",
  {
   "name": "angle_bd",
   "expr": "atan2(pivot_d_z - pivot_b_z, pivot_d_x - pivot_b_x)"
  }
 ],
 [
  "variable.set",
  {
   "name": "angle_bc",
   "expr": "angle_bd - acos((link_bc^2 + toggle_bd^2 - link_cd^2) / (2 * link_bc * toggle_bd))"
  }
 ],
 [
  "variable.set",
  {
   "name": "pivot_c_x",
   "expr": "pivot_b_x + link_bc * cos(angle_bc)"
  }
 ],
 [
  "variable.set",
  {
   "name": "pivot_c_z",
   "expr": "pivot_b_z + link_bc * sin(angle_bc)"
  }
 ],
 [
  "variable.set",
  {
   "name": "closed_link_direction",
   "expr": "atan2(pivot_c_z - pivot_d_z, pivot_c_x - pivot_d_x)"
  }
 ],
 [
  "variable.set",
  {
   "name": "stop_face_x",
   "expr": "pivot_c_x - link_boss_radius - stop_gap - pivot_a_x"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_wx",
   "expr": "(pivot_c_x - pivot_b_x) * cos(handle_opening) - (pivot_c_z - pivot_b_z) * sin(handle_opening)"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_wz",
   "expr": "(pivot_c_x - pivot_b_x) * sin(handle_opening) + (pivot_c_z - pivot_b_z) * cos(handle_opening)"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_px",
   "expr": "pivot_d_x - pivot_a_x - open_wx"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_pz",
   "expr": "pivot_d_z - pivot_a_z - open_wz"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_p",
   "expr": "hypot(open_px, open_pz)"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_link_direction",
   "expr": "atan2(-open_pz, -open_px) - acos((link_cd^2 + open_p^2 - link_ab^2) / (2 * link_cd * open_p))"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_link_angle",
   "expr": "closed_link_direction - open_link_direction"
  }
 ],
 [
  "variable.set",
  {
   "name": "open_bar_angle",
   "expr": "angle_ab - atan2(open_pz + link_cd * sin(open_link_direction), open_px + link_cd * cos(open_link_direction))"
  }
 ],
 [
  "variable.set",
  {
   "name": "reference_sample",
   "expr": "30 / 72"
  }
 ],
 [
  "variable.set",
  {
   "name": "link_open_limit",
   "expr": "88.9 deg"
  }
 ],
 [
  "variable.set",
  {
   "name": "clamped_tolerance",
   "expr": "1e-6"
  }
 ],
 [
  "variable.set",
  {
   "name": "link_drive_angle",
   "expr": "open_link_angle * (1 + cos(360 deg * t)) / 2"
  }
 ],
 [
  "variable.set",
  {
   "name": "knee_cf_x",
   "expr": "pivot_d_x + link_cd * cos(closed_link_direction - link_drive_angle)"
  }
 ],
 [
  "variable.set",
  {
   "name": "knee_cf_z",
   "expr": "pivot_d_z + link_cd * sin(closed_link_direction - link_drive_angle)"
  }
 ],
 [
  "variable.set",
  {
   "name": "knee_to_a",
   "expr": "hypot(knee_cf_x - pivot_a_x, knee_cf_z - pivot_a_z)"
  }
 ],
 [
  "variable.set",
  {
   "name": "bar_cf_direction",
   "expr": "atan2(knee_cf_z - pivot_a_z, knee_cf_x - pivot_a_x) + acos((link_ab^2 + knee_to_a^2 - link_bc^2) / (2 * link_ab * knee_to_a))"
  }
 ],
 [
  "variable.set",
  {
   "name": "hinge_cf_x",
   "expr": "pivot_a_x + link_ab * cos(bar_cf_direction)"
  }
 ],
 [
  "variable.set",
  {
   "name": "hinge_cf_z",
   "expr": "pivot_a_z + link_ab * sin(bar_cf_direction)"
  }
 ],
 [
  "variable.set",
  {
   "name": "bar_cf_rate",
   "expr": "((knee_cf_z - pivot_d_z) * (knee_cf_x - hinge_cf_x) - (knee_cf_x - pivot_d_x) * (knee_cf_z - hinge_cf_z)) / ((hinge_cf_z - pivot_a_z) * (knee_cf_x - hinge_cf_x) - (hinge_cf_x - pivot_a_x) * (knee_cf_z - hinge_cf_z))"
  }
 ],
 [
  "variable.set",
  {
   "name": "handle_cf_rate",
   "expr": "(((knee_cf_z - pivot_d_z) - bar_cf_rate * (hinge_cf_z - pivot_a_z)) * (knee_cf_z - hinge_cf_z) + ((knee_cf_x - pivot_d_x) - bar_cf_rate * (hinge_cf_x - pivot_a_x)) * (knee_cf_x - hinge_cf_x)) / link_bc^2"
  }
 ],
 [
  "variable.set",
  {
   "name": "handle_cf_turn",
   "expr": "atan2(knee_cf_z - hinge_cf_z, knee_cf_x - hinge_cf_x) - angle_bc"
  }
 ],
 [
  "variable.set",
  {
   "name": "grip_cf_x",
   "expr": "hinge_cf_x + grip_force_arm * cos(handle_cf_turn) - (grip_centre_z - pivot_b_z) * sin(handle_cf_turn)"
  }
 ],
 [
  "variable.set",
  {
   "name": "bar_cf_turn",
   "expr": "angle_ab - bar_cf_direction"
  }
 ],
 [
  "variable.set",
  {
   "name": "tip_cf_x",
   "expr": "pivot_a_x - spindle_reach * cos(bar_cf_turn) + (workpiece_height - pivot_a_z) * sin(bar_cf_turn)"
  }
 ],
 [
  "variable.set",
  {
   "name": "advantage_inverse_cf",
   "expr": "abs(bar_cf_rate * (tip_cf_x - pivot_a_x)) / abs(-bar_cf_rate * (hinge_cf_x - pivot_a_x) - handle_cf_rate * (grip_cf_x - hinge_cf_x))"
  }
 ],
