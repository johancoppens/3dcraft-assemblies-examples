   "measure": "jointAngle",
   "mate": "Handle_pivot",
   "label": "Handle joint on the bar",
   "unit": "deg"
  }
 ],
 [
  "variable.measure",
  {
   "name": "workpiece_top",
   "measure": "boxMax",
   "of": "Workpiece",
   "axis": "z"
  }
 ],
 [
  "variable.measure",
  {
   "name": "cap_bottom",
   "measure": "boxMin",
   "of": "Spindle/Rubber cap",
   "axis": "z"
  }
 ],
 [
  "variable.output",
  {
   "name": "bar_rate",
   "expr": "((knee_z - pivot_d_z) * (knee_x - handle_pivot_x) - (knee_x - pivot_d_x) * (knee_z - handle_pivot_z)) / ((handle_pivot_z - pivot_a_z) * (knee_x - handle_pivot_x) - (handle_pivot_x - pivot_a_x) * (knee_z - handle_pivot_z))"
  }
 ],
 [
  "variable.output",
  {
   "name": "handle_rate",
   "expr": "(((knee_z - pivot_d_z) - bar_rate * (handle_pivot_z - pivot_a_z)) * (knee_z - handle_pivot_z) + ((knee_x - pivot_d_x) - bar_rate * (handle_pivot_x - pivot_a_x)) * (knee_x - handle_pivot_x)) / ((knee_x - handle_pivot_x)^2 + (knee_z - handle_pivot_z)^2)"
  }
 ],
 [
  "variable.output",
  {
   "name": "mechanical_advantage",
   "expr": "abs(-bar_rate * (handle_pivot_x - pivot_a_x) - handle_rate * (grip_x - handle_pivot_x)) / abs(bar_rate * (tip_x - pivot_a_x))",
   "label": "Mechanical advantage at the spindle"
  }
 ],
 [
  "assert.add",
  {
   "name": "Knee is past the toggle line at the clamped pose",
   "measure": "jointAngle",
   "mate": "Knee",
   "eq": "over_centre_angle",
   "tol": "0.05 deg",
   "when": "abs(t - 0.5) < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Rubber cap meets the workpiece at the clamped pose",
   "measure": "value",
   "expr": "workpiece_top - cap_bottom",
   "min": "-0.02 mm",
   "max": "0.02 mm",
   "when": "abs(t - 0.5) < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Link rests on the bar's stop pad at the clamped pose",
   "measure": "clearance",
   "from": "Bar",
   "to": "Link",
   "min": "0.02 mm",
   "max": "0.12 mm",
   "when": "abs(t - 0.5) < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bar and link clear each other over the motion",
   "measure": "clearance",
   "from": "Bar",
   "to": "Link",
   "min": "0.02 mm"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bar pivot in the bar has its running fit",
   "measure": "clearance",
   "from": "Bar rivet",
   "to": "Bar",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bar pivot in the near base half has its running fit",
   "measure": "clearance",
   "from": "Bar rivet",
   "to": "Base[1]",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bar pivot in the far base half has its running fit",
   "measure": "clearance",
   "from": "Bar rivet",
   "to": "Base[2]",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Link pivot in the link has its running fit",
   "measure": "clearance",
   "from": "Link rivet",
   "to": "Link",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Link pivot in the near base half has its running fit",
   "measure": "clearance",
   "from": "Link rivet",
   "to": "Base[1]",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Link pivot in the far base half has its running fit",
   "measure": "clearance",
   "from": "Link rivet",
   "to": "Base[2]",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Handle pivot in the handle has its running fit",
   "measure": "clearance",
   "from": "Handle rivet",
   "to": "Handle/Handle",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Handle pivot in the bar has its running fit",
   "measure": "clearance",
   "from": "Handle rivet",
   "to": "Bar",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Knee pivot in the handle has its running fit",
   "measure": "clearance",
   "from": "Knee rivet",
   "to": "Handle/Handle",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Knee pivot in the link has its running fit",
   "measure": "clearance",
   "from": "Knee rivet",
   "to": "Link",
   "min": "fit_clearance_min",
   "max": "fit_clearance_max"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bar opening matches the closed form at the open pose",
   "measure": "jointAngle",
   "mate": "Bar_pivot",
   "eq": "open_bar_angle",
   "tol": "0.02 deg",
   "when": "t < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Handle opening at the open pose is the parameter",
   "measure": "value",
   "expr": "-(bar_angle + handle_joint)",
   "eq": "handle_opening",
   "tol": "0.02 deg",
   "when": "t < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Knee is short of the toggle line while closing",
   "measure": "jointAngle",
   "mate": "Knee",
   "min": "-40 deg",
   "max": "-0.5 deg",
   "when": "abs(t - reference_sample) < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Advantage at the stop, independently computed",
   "measure": "value",
   "expr": "mechanical_advantage * spindle_reach",
   "eq": "601.57 mm",
   "tol": "0.3 mm",
   "when": "abs(t - 0.5) < clamped_tolerance"
  }
 ],
 [
  "assert.add",
  {
   "name": "Spindle to grip ratio matches the closed form of the drive",
   "measure": "value",
   "expr": "1 / mechanical_advantage",
   "eq": "advantage_inverse_cf",
   "tol": "0.001"
  }
 ],
 [
  "assert.add",
  {
   "name": "Bar opens wide enough to load a workpiece",
   "measure": "position",
   "instance": "Spindle",
   "axis": "z",
   "min": "workpiece_height + 30 mm",
   "when": "t < clamped_tolerance"
  }
 ],
