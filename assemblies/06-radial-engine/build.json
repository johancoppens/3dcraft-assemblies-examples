[
[
"assembly.new",
{
"units": "mm"
}
],
[
"variable.set",
{
"name": "t",
"expr": "0.1"
}
],
[
"variable.set",
{
"name": "bore",
"expr": "130 mm"
}
],
[
"variable.set",
{
"name": "stroke",
"expr": "117.5 mm"
}
],
[
"variable.set",
{
"name": "rod_ratio",
"expr": "4"
}
],
[
"variable.set",
{
"name": "start_angle",
"expr": "0 deg"
}
],
[
"variable.set",
{
"name": "angle_step",
"expr": "360 deg / 7"
}
],
[
"variable.set",
{
"name": "crank_radius",
"expr": "stroke / 2"
}
],
[
"variable.set",
{
"name": "rod_length",
"expr": "rod_ratio * crank_radius"
}
],
[
"variable.set",
{
"name": "knuckle_radius",
"expr": "72 mm"
}
],
[
"variable.set",
{
"name": "link_length",
"expr": "rod_length - knuckle_radius"
}
],
[
"variable.set",
{
"name": "crown_height",
"expr": "64 mm"
}
],
[
"variable.set",
{
"name": "head_gap",
"expr": "3 mm"
}
],
[
"variable.set",
{
"name": "dome_depth",
"expr": "41.7 mm"
}
],
[
"variable.set",
{
"name": "deck_height",
"expr": "crank_radius + rod_length + crown_height + head_gap"
}
],
[
"variable.set",
{
"name": "crank_angle",
"expr": "start_angle + 360 deg * t"
}
],
[
"variable.set",
{
"name": "master_cos",
"expr": "sqrt(rod_length^2 - (crank_radius * sin(crank_angle))^2) / rod_length"
}
],
[
"variable.set",
{
"name": "master_sin",
"expr": "-crank_radius * sin(crank_angle) / rod_length"
}
],
