}
],
[
"variable.set",
{
"name": "cw_radius",
"expr": "125 mm"
}
],
[
"variable.set",
{
"name": "cw_half",
"expr": "72 deg"
}
],
[
"variable.set",
{
"name": "edge",
"expr": "1.5 mm"
}
],
[
"variable.set",
{
"name": "end_z",
"expr": "cw_radius * cos(180 deg - cw_half)"
}
],
[
"variable.set",
{
"name": "end_x",
"expr": "cw_radius * sin(180 deg - cw_half)"
}
],
[
"variable.set",
{
"name": "to_end",
"expr": "hypot(end_z - crank_radius, end_x)"
}
],
[
"variable.set",
{
"name": "end_ang",
"expr": "atan2(end_x, end_z - crank_radius)"
}
],
[
"variable.set",
{
"name": "tan_ang",
"expr": "end_ang - acos(web_pin_radius / to_end)"
}
],
[
"variable.set",
{
"name": "tan_z",
"expr": "crank_radius + web_pin_radius * cos(tan_ang)"
}
],
[
"variable.set",
{
"name": "tan_x",
"expr": "web_pin_radius * sin(tan_ang)"
}
],
[
"variable.set",
{
"name": "tail_radius",
"expr": "24 mm"
}
],
[
"variable.set",
{
"name": "tail_length",
"expr": "50 mm"
}
],
[
"variable.set",
{
"name": "tail_end",
