"1 mm"
]
]
}
],
[
"assert.add",
{
"name": "Throw equals the stated crank radius",
"measure": "boxMax",
"of": "Crank front",
"axis": "z",
"eq": "crank_radius + web_pin_radius",
"tol": "0.01"
}
],
[
"assert.add",
{
"name": "The counterweight sector stands opposite the pin",
"measure": "boxMin",
"of": "Crank front",
"axis": "z",
"eq": "-cw_radius",
"tol": "0.01"
}
],
