"max": "800 mm"
}
],
[
"feature.block",
{
"size": [
"beam_length",
"sizes[\"all\"].beam_side",
"sizes[\"all\"].beam_side"
],
"position": [
"0 mm",
"-sizes[\"all\"].beam_side / 2",
"-sizes[\"all\"].beam_side / 2"
],
"name": "Box blank"
}
],
[
"feature.fillet",
{
"edges": [
[
"F1:face(0)",
"F1:face(2)"
],
[
"F1:face(0)",
"F1:face(3)"
],
[
"F1:face(1)",
"F1:face(2)"
],
[
"F1:face(1)",
"F1:face(3)"
]
],
"radius": "sizes[\"all\"].corner_round",
"name": "Rounded blank"
}
],
[
"feature.block",
{
"size": [
"beam_length + 2 mm",
"sizes[\"all\"].beam_side - 2 * sizes[\"all\"].beam_wall",
"sizes[\"all\"].beam_side - 2 * sizes[\"all\"].beam_wall"
],
"position": [
"-1 mm",
"-sizes[\"all\"].beam_side / 2 + sizes[\"all\"].beam_wall",
