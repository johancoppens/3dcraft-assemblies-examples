"0 mm + (1) * 1 mm"
]
]
}
],
[
"datum.plane",
{
"name": "Face z plus",
"through": [
[
"beam_length / 2",
"0 mm",
"sizes[\"all\"].beam_side / 2"
],
[
"beam_length / 2 + (1) * 1 mm",
