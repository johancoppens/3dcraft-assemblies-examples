"tool": "Bore tool",
"name": "Box bored"
}
],
[
"sketch.create",
{
"name": "End bolts",
"plane": "xy",
"offset": "sizes[\"all\"].beam_side / 2 + 1 mm"
}
],
[
"sketch.circle",
{
"sketch": "End bolts",
"center": [
"sizes[\"all\"].end_bolt_first",
"0 mm"
],
"radius": "sizes[\"all\"].end_bolt_clear"
}
],
[
"sketch.circle",
{
"sketch": "End bolts",
"center": [
"sizes[\"all\"].end_bolt_first + sizes[\"all\"].end_bolt_pitch",
"0 mm"
],
"radius": "sizes[\"all\"].end_bolt_clear"
}
],
[
"sketch.circle",
{
"sketch": "End bolts",
"center": [
"beam_length - sizes[\"all\"].end_bolt_first",
"0 mm"
],
"radius": "sizes[\"all\"].end_bolt_clear"
}
],
[
"sketch.circle",
{
"sketch": "End bolts",
"center": [
"beam_length - sizes[\"all\"].end_bolt_first - sizes[\"all\"].end_bolt_pitch",
"0 mm"
],
"radius": "sizes[\"all\"].end_bolt_clear"
}
],
[
"feature.extrude",
{
