[
"variable.set",
{
"name": "belt_pitch_radius",
"expr": "20 * 2 mm / (2 * pi)"
}
],
[
"variable.set",
{
"name": "back_pitch_radius",
"expr": "sizes[\"all\"].back_idler_radius + sizes[\"all\"].pitch_to_back + sizes[\"all\"].belt_gap"
}
],
[
"variable.set",
{
"name": "inboard",
"expr": "-hand"
}
],
[
"variable.set",
{
"name": "idler_inset",
"expr": "sizes[\"all\"].inset - belt_pitch_radius - back_pitch_radius"
}
],
[
"variable.set",
{
"name": "back_sign",
"expr": "if(front > 0.5, inboard, hand)"
}
],
[
"variable.set",
{
"name": "wrap_start",
"expr": "if(front > 0.5, 0 deg, if(hand > 0, 0 deg, 90 deg))"
}
],
[
"variable.set",
{
"name": "wrap_end",
"expr": "if(front > 0.5, 180 deg, if(hand > 0, 90 deg, 180 deg))"
}
],
[
"variable.set",
{
"name": "idler_x",
"expr": "inboard * idler_inset"
}
],
[
"variable.set",
{
"name": "idler_y",
"expr": "-sizes[\"all\"].inset"
}
],
[
"variable.set",
{
"name": "motor_x",
"expr": "inboard * sizes[\"all\"].inset"
}
],
[
"variable.set",
{
"name": "span_start_x",
"expr": "if(front > 0.5, inboard * (idler_inset + belt_pitch_radius), inboard * (sizes[\"all\"].inset - belt_pitch_radius))"
}
],
[
"variable.set",
{
"name": "span_start_y",
"expr": "-sizes[\"all\"].inset - sizes[\"all\"].span_gap"
}
],
[
"variable.set",
{
"name": "half_frame",
"expr": "frame_size / 2"
}
],
[
"variable.set",
{
"name": "track_half",
"expr": "half_frame - 53 mm"
}
],
[
"variable.set",
{
"name": "rear_span_length",
"expr": "2 * track_half + belt_pitch_radius + back_pitch_radius"
}
],
[
"variable.set",
{
"name": "side_span_length",
"expr": "2 * track_half"
}
],
[
"variable.set",
{
"name": "floor_bottom",
