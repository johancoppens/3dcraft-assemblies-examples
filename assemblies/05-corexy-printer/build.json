[
"variable.output",
{
"name": "belt_a_moving",
"expr": "(anchor_a_left_x - left_toothed_span_x) + (rear_left_tangent_y - left_toothed_tangent_y) + (right_back_tangent_y - front_right_tangent_y) + (right_back_span_x - anchor_a_right_x)",
"label": "Belt A: the four moving straight pieces, measured",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "belt_b_moving",
"expr": "(anchor_b_left_x - left_back_span_x) + (rear_right_tangent_y - right_toothed_tangent_y) + (left_back_tangent_y - front_left_tangent_y) + (right_toothed_span_x - anchor_b_right_x)",
"label": "Belt B: the four moving straight pieces, measured",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "belt_a_length",
"expr": "belt_a_moving + belt_static + belt_wraps",
"label": "Belt A: pitch length, measured pieces plus the static runs and wraps",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "belt_b_length",
"expr": "belt_b_moving + belt_static + belt_wraps",
"label": "Belt B: pitch length, measured pieces plus the static runs and wraps",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "pulley_a_radius",
"expr": "hypot(pulley_a_pitch_x - pulley_a_axis_x, pulley_a_pitch_y - pulley_a_axis_y)",
"label": "Motor A pulley: pitch radius measured on the instance",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "pulley_b_radius",
"expr": "hypot(pulley_b_pitch_x - pulley_b_axis_x, pulley_b_pitch_y - pulley_b_axis_y)",
"label": "Motor B pulley: pitch radius measured on the instance",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "belt_a_motor_side",
"expr": "(anchor_a_left_x - left_toothed_span_x) + (rear_left_tangent_y - left_toothed_tangent_y)",
"label": "Belt A: carriage to motor, measured",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "belt_b_motor_side",
"expr": "(right_toothed_span_x - anchor_b_right_x) + (rear_right_tangent_y - right_toothed_tangent_y)",
"label": "Belt B: carriage to motor, measured",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "nozzle_radial",
"expr": "hypot(nozzle_x - vase_axis_x, nozzle_y - vase_axis_y)",
"label": "Nozzle's distance from the vase's axis",
"unit": "mm"
}
],
[
"variable.output",
{
"name": "rim_radial",
"expr": "hypot(rim_x - vase_axis_x, rim_y - vase_axis_y)",
"label": "The vase's rim: its wall centre, read off the vase",
"unit": "mm"
}
],
[
"assert.add",
{
"name": "Motor A turns by the CoreXY equation for the measured carriage and the drawn pulley",
"measure": "value",
"expr": "motor_a_measured / (1 rad) * pulley_a_radius - (head_x - gantry_y)",
"eq": "0 mm",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Motor B turns by the CoreXY equation for the measured carriage and the drawn pulley",
"measure": "value",
"expr": "motor_b_measured / (1 rad) * pulley_b_radius - (head_x + gantry_y)",
"eq": "0 mm",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Belt A is one constant length over the motion",
"measure": "value",
"expr": "belt_a_moving",
"eq": "belt_moving_expected",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Belt B is one constant length over the motion",
"measure": "value",
"expr": "belt_b_moving",
"eq": "belt_moving_expected",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Belt A's motor pays out what the carriage side takes up",
"measure": "value",
"expr": "belt_a_motor_side - motor_a_measured / (1 rad) * pulley_a_radius",
"eq": "2 * track_half - sizes[\"all\"].tower_x",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Belt B's motor pays out what the carriage side takes up",
"measure": "value",
"expr": "belt_b_motor_side + motor_b_measured / (1 rad) * pulley_b_radius",
"eq": "2 * track_half - sizes[\"all\"].tower_x",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Frame idlers roll with their belts",
"measure": "value",
"expr": "max(abs(idler_a_rear_measured / (1 rad) * pulley_a_radius - (belt_a_motor_side - (2 * track_half - sizes[\"all\"].tower_x))), max(abs(idler_a_front_measured / (1 rad) * pulley_a_radius - (belt_a_motor_side - (2 * track_half - sizes[\"all\"].tower_x))), max(abs(idler_b_rear_measured / (1 rad) * pulley_b_radius - (2 * track_half - sizes[\"all\"].tower_x - belt_b_motor_side)), abs(idler_b_front_measured / (1 rad) * pulley_b_radius - (2 * track_half - sizes[\"all\"].tower_x - belt_b_motor_side)))))",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Gantry idlers roll with their belts",
"measure": "value",
"expr": "max(abs(idler_a_left_measured / (1 rad) * pulley_a_radius - ((anchor_a_left_x - left_toothed_span_x) - (track_half - sizes[\"all\"].tower_x))), max(abs(idler_a_right_measured / (1 rad) * back_pitch_radius + ((track_half - sizes[\"all\"].tower_x) - (right_back_span_x - anchor_a_right_x))), max(abs(idler_b_left_measured / (1 rad) * back_pitch_radius + ((anchor_b_left_x - left_back_span_x) - (track_half - sizes[\"all\"].tower_x))), abs(idler_b_right_measured / (1 rad) * pulley_b_radius - ((track_half - sizes[\"all\"].tower_x) - (right_toothed_span_x - anchor_b_right_x))))))",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Toothed idler turns on its pin with its running fit",
"measure": "clearance",
"from": "Idler A left",
"to": "Gantry/End left/Idler bolt",
"min": "0.02 mm",
"max": "0.1 mm"
}
],
[
"assert.add",
{
"name": "Back idler turns on its pin with its running fit",
"measure": "clearance",
"from": "Idler A right",
"to": "Gantry/End right/Idler bolt",
"min": "0.02 mm",
"max": "0.1 mm"
}
],
[
"assert.add",
{
"name": "Motor pulley sits on its shaft with its fit",
"measure": "clearance",
"from": "Motor A pulley",
"to": "Frame/Motor A stator/Shaft",
"min": "0.02 mm",
"max": "0.1 mm"
}
],
[
"assert.add",
{
"name": "Belt A's drawn spans reach the toolhead clamps",
"measure": "value",
"expr": "max(abs(anchor_a_left_x - a_left_end_x - span_gap), abs(a_right_end_x - anchor_a_right_x - span_gap))",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Belt B's drawn spans reach the toolhead clamps",
"measure": "value",
"expr": "max(abs(b_right_end_x - anchor_b_right_x - span_gap), abs(anchor_b_left_x - b_left_end_x - span_gap))",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "The drawn Y spans reach the gantry idlers",
"measure": "value",
"expr": "max(abs(a_rear_end_y - left_toothed_tangent_y - span_gap), max(abs(right_back_tangent_y - a_front_end_y - span_gap), max(abs(b_rear_end_y - right_toothed_tangent_y - span_gap), abs(left_back_tangent_y - b_front_end_y - span_gap))))",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Nozzle runs over the rim radially",
"measure": "value",
"expr": "nozzle_radial - rim_radial",
"eq": "0 mm",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Nozzle is one layer above the rim",
"measure": "value",
"expr": "nozzle_z - rim_z",
"eq": "sizes[\"all\"].layer_height",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Nozzle clears the wall by about one layer",
"measure": "clearance",
"from": "Toolhead/Hot end/Nozzle",
"to": "Vase",
"min": "0.1 mm",
"max": "0.35 mm"
}
],
[
"assert.add",
{
"name": "Bed follows the left screw",
"measure": "value",
"expr": "bed_z - first_layer_bed + screw_left_measured / (360 deg) * sizes[\"all\"].lead",
"eq": "0 mm",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Bed follows the right screw",
"measure": "value",
"expr": "bed_z - first_layer_bed + screw_right_measured / (360 deg) * sizes[\"all\"].lead",
"eq": "0 mm",
"tol": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Bed is at the first layer at the start",
"measure": "value",
"expr": "bed_z",
"eq": "first_layer_bed",
"tol": "0.02 mm",
"when": "abs(t) < 0.0001"
}
],
[
"assert.add",
{
"name": "Bed has dropped the full print height at the end",
"measure": "value",
"expr": "bed_z",
"eq": "nozzle_tip_height - sizes[\"all\"].layer_height - vase_height",
"tol": "0.02 mm",
"when": "abs(t - 1) < 0.0001"
}
],
[
"assert.add",
{
"name": "Left nut floats by the screw's misalignment",
"measure": "value",
"expr": "hypot(float_left_x - sizes[\"all\"].z_misalignment, float_left_y - sizes[\"all\"].float_y_share * sizes[\"all\"].z_misalignment)",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Right nut floats by the screw's misalignment",
"measure": "value",
"expr": "hypot(float_right_x + sizes[\"all\"].z_misalignment, float_right_y - sizes[\"all\"].float_y_share * sizes[\"all\"].z_misalignment)",
"max": "0.02 mm"
}
],
[
"assert.add",
{
"name": "Toolhead stays on its rail",
"measure": "value",
"expr": "abs(head_x)",
"max": "(frame_size - sizes[\"all\"].x_rail_cut) / 2 - sizes[\"all\"].carriage_half_length"
}
],
[
"assert.add",
{
"name": "Gantry stays on its rails",
"measure": "value",
"expr": "abs(gantry_y)",
"max": "(frame_size - sizes[\"all\"].y_rail_cut) / 2 - sizes[\"all\"].carriage_half_length"
}
],
[
"assert.add",
{
"name": "Left Y carriage rides its rail with its clearance",
