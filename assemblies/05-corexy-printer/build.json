[
"variable.set",
{
"name": "t",
"expr": "0.62"
}
],
[
"variable.set",
{
"name": "build_size",
"expr": "250 mm"
}
],
[
"variable.set",
{
"name": "vase_height",
"expr": "180 mm"
}
],
[
"variable.set",
{
"name": "vase_belly",
"expr": "34 mm"
}
],
[
"variable.set",
{
"name": "spiral_turns",
"expr": "6"
}
],
[
"variable.set",
{
"name": "vase_start",
"expr": "sizes[\"all\"].vase_floor + 1 mm"
}
],
[
"variable.set",
{
"name": "frame_size",
"expr": "build_size + 250 mm"
}
],
[
"variable.set",
{
"name": "half_frame",
"expr": "frame_size / 2"
}
],
[
"variable.set",
{
"name": "track_half",
"expr": "half_frame - sizes[\"all\"].pulley_inset"
}
],
[
"variable.set",
{
"name": "belt_pitch_radius",
"expr": "20 * 2 mm / (2 * pi)"
}
],
[
"variable.set",
{
"name": "back_pitch_radius",
"expr": "6.5 mm + 0.5 mm + 0.055 mm"
}
],
[
"variable.set",
{
"name": "span_gap",
"expr": "0.05 mm"
}
],
[
"variable.set",
{
"name": "nozzle_tip_height",
"expr": "frame_size - sizes[\"all\"].nozzle_below_frame_top"
}
],
[
"variable.set",
{
"name": "first_layer_bed",
"expr": "nozzle_tip_height - sizes[\"all\"].layer_height - vase_start"
}
],
[
"variable.set",
{
"name": "nut_start_offset",
"expr": "first_layer_bed - sizes[\"all\"].float_face_below_bed - sizes[\"all\"].screw_seat_height"
}
],
[
"variable.set",
{
"name": "print_height",
"expr": "vase_start + (vase_height - vase_start) * t"
}
],
[
"variable.set",
{
"name": "rim_outer",
"expr": "sizes[\"all\"].vase_foot + vase_belly * sin(180 deg * print_height / vase_height)^2 + sizes[\"all\"].vase_lip * (print_height / vase_height)^8"
}
],
[
"variable.set",
{
"name": "nozzle_radius",
"expr": "rim_outer - sizes[\"all\"].vase_wall / 2"
}
],
[
"variable.set",
{
"name": "spiral_angle",
"expr": "360 deg * spiral_turns * t"
}
],
[
"variable.set",
{
"name": "cmd_x",
"expr": "nozzle_radius * cos(spiral_angle)"
}
],
[
"variable.set",
{
"name": "cmd_y",
"expr": "nozzle_radius * sin(spiral_angle) + sizes[\"all\"].nozzle_offset_y - sizes[\"all\"].bed_shift"
}
],
[
"variable.set",
{
"name": "cmd_motor_a",
"expr": "(cmd_x - cmd_y) / belt_pitch_radius * 1 rad"
}
],
[
"variable.set",
{
"name": "cmd_motor_b",
"expr": "(cmd_x + cmd_y) / belt_pitch_radius * 1 rad"
}
],
[
"variable.set",
{
"name": "cmd_screw",
"expr": "(print_height - vase_start) / sizes[\"all\"].lead * 360 deg"
}
],
[
"variable.set",
{
"name": "span_y_rear",
"expr": "track_half - cmd_y - 2 * span_gap"
}
],
[
"variable.set",
{
"name": "span_y_front",
"expr": "track_half + cmd_y - 2 * span_gap"
}
],
[
"variable.set",
{
"name": "span_x_left",
"expr": "cmd_x - sizes[\"all\"].tower_x + track_half - 2 * span_gap"
}
],
[
"variable.set",
{
"name": "span_x_right",
"expr": "track_half - cmd_x - sizes[\"all\"].tower_x - 2 * span_gap"
}
],
[
"variable.set",
{
"name": "belt_wraps",
"expr": "2.5 * pi * belt_pitch_radius + pi / 2 * back_pitch_radius"
}
],
[
"variable.set",
{
"name": "belt_static",
"expr": "4 * track_half + belt_pitch_radius + back_pitch_radius"
}
],
[
"variable.set",
{
"name": "belt_moving_expected",
"expr": "4 * track_half - 2 * sizes[\"all\"].tower_x"
}
],
[
"variable.set",
{
"name": "belt_length_expected",
"expr": "belt_static + belt_moving_expected + belt_wraps"
}
],
